<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VSClaudio</RootNamespace>
    <AssemblyName>VSClaudio</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <DeployExtension>true</DeployExtension>
    <!-- Core uses Newtonsoft.Json 13.0.3. Every 13.x release has assembly version 13.0.0.0, so it binds to the copy VS ships. -->
    <CheckNewtonsoftJsonVersion>false</CheckNewtonsoftJsonVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\VSClaudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="VSCommandTable.vsct" ResourceName="Menus.ctmenu" />
    <Content Include="web\**\*" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sidecar\vsclaudio-sidecar.exe" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <!-- The image service finds *.imagemanifest files in the extension folder; the manifest loads the PNGs from the assembly resources. -->
    <Content Include="Resources\VSClaudio.imagemanifest" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\VSClaudio16.png;Resources\VSClaudio32.png" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Resources\VSClaudio16.png;Resources\VSClaudio32.png" />
    <None Include="Resources\MakeIcon.ps1" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
